{
  "model": {
    "backbone": "repair_query"
  },
  "repair_query": {
    "token_dim": 128,
    "num_heads": 8,
    "num_decoder_blocks": 3,
    "mlp_hidden_dim": 256,
    "dropout": 0.0,
    "region_size_cells": 12,
    "context_region_radius": 1,
    "use_radar_query_feature": true,
    "use_presence_flags": true,
    "shifted_query_attention": true
  },
  "pointpillars": {
    "enabled": true,
    "output_channels": 64,
    "max_points_per_pillar": 100,
    "max_pillars": 12000,
    "lidar_use_reflectivity": true,
    "radar_use_power": true,
    "radar_use_radial_velocity": true
  },
  "coarse_reconstruction": {
    "enabled": true,
    "unet": {
      "base_channels": 16,
      "depth": 4,
      "normalization": "group_norm",
      "activation": "silu",
      "dropout": 0.0,
      "use_healthy_context_mask": true
    },
    "global_context": {
      "base_channels": 16,
      "channel_multipliers": [1, 2, 4, 8, 16],
      "attention_dim": 128,
      "num_heads": 4,
      "attention_dropout": 0.0,
      "return_attention_during_validation": true
    },
    "loss": {
      "lambda_occupancy": 1.0,
      "lambda_density": 1.0,
      "lambda_height": 1.0,
      "epsilon": 1e-8,
      "observability_weighting": {
        "enabled": false,
        "min_empty_weight": 0.1
      }
    }
  },
  "fault_selector": {
    "min_lidar_loss_fraction": 0.95,
    "min_repair_box_cells": 5,
    "min_repair_fault_fraction": 0.95,
    "min_halo_healthy_fraction": 0.9,
    "min_halo_healthy_cells": 64,
    "min_halo_context_ratio": 0.25,
    "min_halo_width_cells": 4,
    "max_halo_dilation_cells": 64
  },
  "training": {
    "epochs": 50,
    "batch_size": 8,
    "num_workers": 4,
    "learning_rate": 0.0002,
    "weight_decay": 0.001,
    "grad_clip": 1.0,
    "mixed_precision": true,
    "save_conditioning_samples": 4,
    "seed": 42
  }
}
