{
  "coarse_reconstruction": {
    "enabled": true,
    "unet": {
      "base_channels": 16,
      "depth": 5,
      "normalization": "group_norm",
      "activation": "silu",
      "dropout": 0.0
    },
    "global_context": {
      "use_full_spatial_map": true,
      "use_global_average_pooling": false,
      "crop_global_context": false,
      "base_channels": 16,
      "channel_multipliers": [1, 2, 4, 8, 16],
      "attention_dim": 128,
      "num_heads": 4,
      "num_cross_attention_blocks": 1,
      "attention_dropout": 0.0,
      "return_attention_during_validation": true
    },
    "loss": {
      "reconstruction_loss_type": "smooth_l1",
      "lambda_reconstruction": 1.0,
      "lambda_occupancy": 0.0,
      "lambda_offset": 0.0,
      "epsilon": 1e-8
    }
  },
  "fault_selector": {
    "threshold": 0.0,
    "min_blob_cells": 5,
    "max_blobs": 3,
    "merge_radius_cells": 4,
    "box_padding_cells": 2,
    "combine_gap_cells": 40,
    "min_relative_blob_size": 0.05,
    "bbox_quantile": 0.01,
    "min_repair_fault_fraction": 0.75,
    "min_halo_healthy_fraction": 0.9,
    "min_halo_healthy_cells": 64,
    "min_halo_context_ratio": 0.25,
    "min_halo_width_cells": 4,
    "healthy_reliability_threshold": 1.0
  },
  "training": {
    "epochs": 50,
    "batch_size": 8,
    "num_workers": 4,
    "learning_rate": 0.0002,
    "weight_decay": 0.001,
    "grad_clip": 1.0,
    "mixed_precision": true,
    "save_conditioning_samples": 4,
    "seed": 42
  }
}
