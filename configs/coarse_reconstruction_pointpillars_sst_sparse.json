{
  "model": {
    "backbone": "sst"
  },
  "sst": {
    "token_dim": 128,
    "num_blocks": 6,
    "num_heads": 8,
    "mlp_hidden_dim": 256,
    "region_size_cells": 12,
    "shift_size_cells": 6,
    "dropout": 0.0,
    "include_repair_tokens": false,
    "sparse_pointpillars_only": true
  },
  "pointpillars": {
    "enabled": true,
    "output_channels": 64,
    "max_points_per_pillar": 100,
    "max_pillars": 12000,
    "lidar_use_reflectivity": true,
    "radar_use_power": true,
    "radar_use_radial_velocity": true
  },
  "coarse_reconstruction": {
    "enabled": true,
    "unet": {
      "base_channels": 16,
      "depth": 4,
      "normalization": "group_norm",
      "activation": "silu",
      "dropout": 0.0,
      "use_healthy_context_mask": true
    },
    "global_context": {
      "base_channels": 16,
      "channel_multipliers": [1, 2, 4, 8, 16],
      "attention_dim": 128,
      "num_heads": 4,
      "attention_dropout": 0.0,
      "return_attention_during_validation": true
    },
    "loss": {
      "lambda_occupancy": 1.0,
      "lambda_density": 1.0,
      "lambda_height": 1.0,
      "epsilon": 1e-8,
      "observability_weighting": {
        "enabled": false,
        "min_empty_weight": 0.1
      }
    }
  },
  "fault_selector": {
    "threshold": 0.0,
    "min_blob_cells": 5,
    "max_blobs": 3,
    "merge_radius_cells": 4,
    "box_padding_cells": 2,
    "combine_gap_cells": 40,
    "min_relative_blob_size": 0.05,
    "bbox_quantile": 0.01,
    "min_repair_fault_fraction": 0.75,
    "min_halo_healthy_fraction": 0.9,
    "min_halo_healthy_cells": 64,
    "min_halo_context_ratio": 0.25,
    "min_halo_width_cells": 4,
    "healthy_reliability_threshold": 1.0
  },
  "training": {
    "epochs": 50,
    "batch_size": 8,
    "num_workers": 4,
    "learning_rate": 0.0002,
    "weight_decay": 0.001,
    "grad_clip": 1.0,
    "mixed_precision": true,
    "save_conditioning_samples": 4,
    "seed": 42
  }
}
